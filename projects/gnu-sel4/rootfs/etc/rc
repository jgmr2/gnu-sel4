#!/bin/sh
# /etc/rc: run by init at boot, before the login shell.
#
# SPDX-License-Identifier: BSD-2-Clause

# Services (see /etc/s6-rc/README): s6-svscan supervises the scan directory /run/service and
# s6-rc brings the "default" bundle up in dependency order: the network configuration
# (a oneshot) and 9pd (supervised: started again if it dies). /run starts clean at every boot.
# The live system on real hardware tells what it is doing (nothing else to look at there)
case " $(cat /etc/test 2>/dev/null) " in *" live "*) status() { echo "  ... $*"; } ;; *) status() { :; } ;; esac

# After an unclean shutdown fs_ext2 mounts / read-only: e2fsck checks (and repairs) /dev/root
# first, then / goes read-write. Nothing may write to the disk before this
read -r dev dir type opts rest </proc/mounts
case ",$opts," in *,ro,*)
    echo "rc: the disk was not cleanly unmounted: checking it (e2fsck -p /dev/root)"
    out=$(e2fsck -p /dev/root 2>&1); r=$?
    printf '%s\n' "$out"
    # 0: clean; 1: errors fixed; 2 (with 1: 3): "reboot", which Linux needs because its caches may
    # hold the old metadata. Not here: what e2fsck writes goes through fs_ext2's cache, and the
    # remount reads the superblock and group descriptors again
    if [ $r -lt 4 ] && mount -o remount,rw /; then
        echo "rc: e2fsck finished ($r): / is read-write"
        printf 'exit %s\n%s\n' "$r" "$out" > /run/fsck-boot.log
    else
        echo "rc: e2fsck could not repair everything ($r): / stays READ-ONLY." >&2
        echo "rc: as root: e2fsck -f /dev/root, then mount -o remount,rw /" >&2
    fi ;;
esac
status "rc: starting the services (s6-svscan, s6-rc: network, 9pd)"
rm -rf /run/service /run/s6-rc /run/s6-rc:* /run/s6-rc-db
mkdir -p /run/service
s6-svscan /run/service </dev/null >/tmp/s6-svscan.log 2>&1 &
i=0; while [ ! -p /run/service/.s6-svscan/control ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
{ s6-rc-compile /run/s6-rc-db /etc/s6-rc/source && s6-rc-init -c /run/s6-rc-db /run/service &&
  s6-rc -u change default; } >/tmp/s6-rc.log 2>&1 ||
    echo "rc: s6-rc failed to start the services (see /tmp/s6-rc.log)" >&2
status "rc: services up; the Linux VM keeps booting in the background"

# make test: if /etc/test exists, run the automated tests (results go to /dev/kmsg)
[ -f /etc/test ] && sh /etc/tests.sh
