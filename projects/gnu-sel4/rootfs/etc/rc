#!/bin/sh
# /etc/rc: run by init at boot, before the login shell.
#
# SPDX-License-Identifier: BSD-2-Clause

# Native networking: DHCP or a static address, per /etc/netcfg.conf
netcfg apply

# Services, supervised by s6 (they are started again if they die): one directory per service
# in /etc/s6/sv, enabled by a symlink in /run/service. s6-svc / s6-svstat control them.
s6-svscan /run/service </dev/null >/tmp/s6-svscan.log 2>&1 &

# make test: if /etc/test exists, run the automated tests (results go to /dev/kmsg)
[ -f /etc/test ] && sh /etc/tests.sh
