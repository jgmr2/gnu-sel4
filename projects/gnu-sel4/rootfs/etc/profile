# /etc/profile: read by the login shell at startup
#
# SPDX-License-Identifier: BSD-2-Clause
export PATH=/bin:/sbin:/usr/bin
export HOME=/root
export TERM=xterm-256color
PS1='root@gnu-sel4:$PWD# '
cd "$HOME"
# real window size (it does not arrive by itself over the serial port; `resize` measures it again)
[ -t 0 ] && resize -s
cat /etc/motd
