#!/bin/sh
# Stage 1 (initramfs): copies the system into a tmpfs and switches to it.
# Docker needs "/" to be a real file system: pivot_root does not work on
# the initramfs rootfs.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mkdir -p /newroot
mount -t tmpfs -o size=90%,mode=755 tmpfs /newroot

tar -C / -cf - --exclude=./proc --exclude=./newroot . | tar -C /newroot -xf -
mkdir -p /newroot/proc
umount /proc
exec switch_root /newroot /sbin/init
