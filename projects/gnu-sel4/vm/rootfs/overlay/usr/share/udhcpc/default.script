#!/bin/sh
# udhcpc script: applies the IP, default route and DNS the DHCP server hands out
case "$1" in
    deconfig)
        ip addr flush dev "$interface"
        ;;
    bound|renew)
        ip addr flush dev "$interface"
        ip addr add "$ip/${mask:-24}" dev "$interface"
        for r in $router; do ip route replace default via "$r" dev "$interface"; break; done
        : > /etc/resolv.conf
        for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
        echo "net: $interface $ip/${mask:-24}, gateway $router, dns $dns"
        ;;
esac
