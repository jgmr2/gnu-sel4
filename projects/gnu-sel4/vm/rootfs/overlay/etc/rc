#!/bin/sh
# System boot: mounts, cgroups, modules and network. "/" is already the VM's disk (/init).
#
# SPDX-License-Identifier: BSD-2-Clause
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 shm /dev/shm
mount -t tmpfs -o mode=755 run /run
mount -t cgroup2 cgroup2 /sys/fs/cgroup
# Enable every cgroup controller for children (Docker uses them)
for c in $(cat /sys/fs/cgroup/cgroup.controllers); do
    echo "+$c" > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null
done

# virtio drivers (disk and network) and what Docker needs for its networks
for m in virtio_blk virtio_net ext4 overlay bridge br_netfilter veth \
         nf_tables nft_compat nf_nat nf_conntrack xt_MASQUERADE xt_conntrack xt_addrtype \
         9pnet 9pnet_fd 9p vmw_vsock_virtio_transport; do
    modprobe -q $m
done
hostname -F /etc/hostname
ip link set lo up

grep -q ' / ext4 ' /proc/mounts || echo "rc: no disk, everything is in RAM (lost at shutdown)"

# Network: DHCP on eth0 (QEMU user-net hands out 10.0.2.15, gateway 10.0.2.2, DNS 10.0.2.3)
echo 1 > /proc/sys/net/ipv4/ip_forward
if ip link show eth0 >/dev/null 2>&1; then
    ip link set eth0 up
    udhcpc -i eth0 -b -q -t 10 -s /usr/share/udhcpc/default.script
fi

# Real time via NTP: the virtual clock starts at a fixed date, and without the
# right time TLS certificates fail (docker pull).
ntpd -n -q -p pool.ntp.org >/dev/null 2>&1 && echo "rc: time synchronised: $(date)"
