                 child_name => {
                     let location = loc_string(xml_sdf, child.range().start);
                     if let Some(type_name) = child_name.strip_prefix("cap_") {
@@ -113,6 +125,56 @@ impl CSpace {
 }
 
 impl CapMap {
+    fn slot_from_xml(xml_sdf: &SystemDescriptionFile, node: &dyn SdfNode) -> Result<u64, String> {
+        let slot: u64 = sdf_parse_required_attribute(xml_sdf, node, "slot")?;
+        if slot == 0 || slot >= CAP_MAP_MAX_SLOT {
+            return Err(value_error(
+                xml_sdf,
+                node,
+                format!("The destination slot must be in 1..{CAP_MAP_MAX_SLOT}"),
+            ));
+        }
+        Ok(slot)
+    }
+
+    /// `<cap_asid_pool slot="..."/>`
+    fn asid_pool_from_xml(
+        xml_sdf: &SystemDescriptionFile,
+        node: &dyn SdfNode,
+    ) -> Result<CapMap, String> {
+        check_attributes(xml_sdf, node, &["slot"])?;
+        Ok(CapMap {
+            cap_type: CapMapType::AsidPool,
+            pd: Rc::from(""),
+            slot: Self::slot_from_xml(xml_sdf, node)?,
+            text_pos: node.range().start,
+        })
+    }
+
+    /// `<cap_sched_pool slot="..." count="..." budget="..." period="..."/>`
+    fn sched_pool_from_xml(
+        xml_sdf: &SystemDescriptionFile,
+        node: &dyn SdfNode,
+    ) -> Result<CapMap, String> {
+        check_attributes(xml_sdf, node, &["slot", "count", "budget", "period"])?;
+        let count: u64 = sdf_parse_required_attribute(xml_sdf, node, "count")?;
+        let budget: u64 = sdf_parse_attribute(xml_sdf, node, "budget")?.unwrap_or(BUDGET_DEFAULT);
+        let period: u64 = sdf_parse_attribute(xml_sdf, node, "period")?.unwrap_or(budget);
+        if count == 0 || count > 4096 || budget > period {
+            return Err(value_error(
+                xml_sdf,
+                node,
+                "count must be in 1..=4096 and budget <= period".to_string(),
+            ));
+        }
+        Ok(CapMap {
+            cap_type: CapMapType::SchedPool { count, budget, period },
+            pd: Rc::from(""),
+            slot: Self::slot_from_xml(xml_sdf, node)?,
+            text_pos: node.range().start,
+        })
+    }
+
     /// `<cap_untyped slot="..." size="..."/>`: the size must be a power of two
     fn untyped_from_xml(
         xml_sdf: &SystemDescriptionFile,
