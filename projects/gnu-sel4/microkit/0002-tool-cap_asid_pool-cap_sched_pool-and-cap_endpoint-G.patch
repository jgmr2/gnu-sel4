Subject: [PATCH 2/2] tool: <cap_asid_pool>, <cap_sched_pool> and
 <cap_endpoint> (GNU/seL4 dynamic processes)

---
 tool/microkit/src/capdl/builder.rs | 59 ++++++++++++++++++++++++++-
 tool/microkit/src/sdf.rs           |  5 ++-
 tool/microkit/src/sdf/cspace.rs    | 64 +++++++++++++++++++++++++++++-
 tool/microkit/src/sdf/pd_vm.rs     |  3 ++
 4 files changed, 128 insertions(+), 3 deletions(-)

diff --git a/tool/microkit/src/capdl/builder.rs b/tool/microkit/src/capdl/builder.rs
index c86cc0c..05952d5 100644
--- a/tool/microkit/src/capdl/builder.rs
+++ b/tool/microkit/src/capdl/builder.rs
@@ -1339,6 +1339,51 @@ pub fn build_capdl_spec(
                     }),
                 });
                 Cap::Untyped(cap::Untyped { object: ut_obj_id })
+            } else if let CapMapType::AsidPool = cap_map.cap_type {
+                // Pool 0 is the initial task's; ours come after it
+                let high = spec_container.spec.asid_slots.len() as u64 + 1;
+                let pool_obj_id = spec_container.add_root_object(CapDLNamedObject {
+                    name: format!("asid_pool_{}_{}", pd.name, cap_map.slot).into(),
+                    object: Object::AsidPool(object::AsidPool { high: Word(high) }),
+                });
+                spec_container.spec.asid_slots.push(pool_obj_id);
+                Cap::AsidPool(cap::AsidPool {
+                    object: pool_obj_id,
+                })
+            } else if let CapMapType::SchedPool {
+                count,
+                budget,
+                period,
+            } = cap_map.cap_type
+            {
+                let bits = count.next_power_of_two().ilog2() as u8;
+                let mut slots = Vec::new();
+                for i in 0..count {
+                    let sc_obj_id = capdl_util_make_sc_obj(
+                        &mut spec_container,
+                        &format!("{}_pool_{}_{i}", pd.name, cap_map.slot),
+                        PD_SCHEDCONTEXT_EXTRA_SIZE_BITS as u8,
+                        period,
+                        budget,
+                        0,
+                    );
+                    slots.push(capdl_util_make_cte(
+                        i as u32,
+                        capdl_util_make_sc_cap(sc_obj_id),
+                    ));
+                }
+                let cnode_obj_id = capdl_util_make_cnode_obj(
+                    &mut spec_container,
+                    &format!("{}_sched_pool_{}", pd.name, cap_map.slot),
+                    bits,
+                    slots,
+                );
+                // (slot << 58) | i names the i-th scheduling context
+                capdl_util_make_cnode_cap(
+                    cnode_obj_id,
+                    0,
+                    (kernel_config.cap_address_bits - PD_ROOT_CAP_BITS as u64 - bits as u64) as u8,
+                )
             } else {
                 let pd_src_shadow_cspace = &pd_shadow_cspaces[&cap_map.pd];
                 match cap_map.cap_type {
@@ -1349,12 +1394,21 @@ pub fn build_capdl_spec(
                     }
                     // Guard so that the cptr (slot << 58) | i resolves to root[i] and
                     // (slot << 58) | slot names this cap: usable as `root` in invocations
+                    CapMapType::Endpoint => capdl_util_make_endpoint_cap(
+                        pd_src_shadow_cspace
+                            .endpoint
+                            .expect("exists as needs_ep() is true"),
+                        RIGHTS_EP_CALL,
+                        0,
+                    ),
                     CapMapType::CNode => capdl_util_make_cnode_cap(
                         pd_src_shadow_cspace.cspace,
                         0,
                         (kernel_config.cap_address_bits - 2 * PD_ROOT_CAP_BITS as u64) as u8,
                     ),
-                    CapMapType::Untyped { .. } => unreachable!(),
+                    CapMapType::Untyped { .. }
+                    | CapMapType::AsidPool
+                    | CapMapType::SchedPool { .. } => unreachable!(),
                 }
             };
 
@@ -1458,6 +1512,9 @@ pub fn build_capdl_spec(
     for irq in spec_container.spec.irqs.iter_mut() {
         irq.handler = obj_old_id_to_new_id[&irq.handler];
     }
+    for pool in spec_container.spec.asid_slots.iter_mut() {
+        *pool = obj_old_id_to_new_id[pool];
+    }
 
     // Only for aesthetic purposes:
     // Sort cap entries by their index.
