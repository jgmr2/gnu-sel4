 };
 use super::{SdfLocation, SdfNode, SystemDescriptionFile};
 
@@ -19,8 +20,16 @@ pub enum CapMapType {
     VSpace,
     /// Root CNode of a PD: lets the holder grow its CSpace (gnu-sel4)
     CNode,
+    /// Endpoint of a PD with call rights, unbadged: the holder can mint badged
+    /// copies for threads created at run time (gnu-sel4)
+    Endpoint,
     /// A fresh untyped of 2^size_bits bytes, created only for this PD (gnu-sel4)
     Untyped { size_bits: u8 },
+    /// A fresh ASID pool, to give an ASID to VSpaces created at run time (gnu-sel4)
+    AsidPool,
+    /// A CNode with `count` configured scheduling contexts, for threads created
+    /// at run time (gnu-sel4)
+    SchedPool { count: u64, budget: u64, period: u64 },
 }
 
 #[derive(Debug, PartialEq, Eq)]
@@ -96,7 +105,10 @@ impl CSpace {
                 "cap_sc" => CapMap::from_xml(CapMapType::Sc, xml_sdf, &*child)?,
                 "cap_vspace" => CapMap::from_xml(CapMapType::VSpace, xml_sdf, &*child)?,
                 "cap_cnode" => CapMap::from_xml(CapMapType::CNode, xml_sdf, &*child)?,
