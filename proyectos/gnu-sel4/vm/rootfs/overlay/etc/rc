#!/bin/sh
# Arranque del sistema: montajes, cgroups, módulos, disco persistente y red.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 shm /dev/shm
mount -t tmpfs -o mode=755 run /run
mount -t cgroup2 cgroup2 /sys/fs/cgroup
# Activar todos los controladores de cgroup para los hijos (los usa Docker)
for c in $(cat /sys/fs/cgroup/cgroup.controllers); do
    echo "+$c" > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null
done

# Drivers virtio (disco y red) y lo que Docker necesita para sus redes
for m in virtio_blk virtio_net ext4 overlay bridge br_netfilter veth \
         nf_tables nft_compat nf_nat nf_conntrack xt_MASQUERADE xt_conntrack xt_addrtype \
         9pnet 9pnet_fd 9p; do
    modprobe -q $m
done
hostname -F /etc/hostname
ip link set lo up

# Disco persistente: /dev/vda -> /var/lib/docker (imágenes y contenedores)
if [ -b /dev/vda ]; then
    # Peticiones de 128 KiB máximo para no saturar el búfer compartido con el driver de disco (sDDF)
    echo 128 > /sys/block/vda/queue/max_sectors_kb
    if ! e2fsck -p /dev/vda >/dev/null 2>&1; then
        echo "rc: /dev/vda sin ext4, formateando (primer arranque)..."
        mkfs.ext4 -q -F -L docker /dev/vda
    fi
    mount -t ext4 /dev/vda /var/lib/docker && echo "rc: disco montado en /var/lib/docker"
else
    echo "rc: sin disco, Docker usará RAM (se pierde al apagar)"
fi

# Red: DHCP en eth0 (QEMU user-net da 10.0.2.15, gateway 10.0.2.2, DNS 10.0.2.3)
echo 1 > /proc/sys/net/ipv4/ip_forward
if ip link show eth0 >/dev/null 2>&1; then
    ip link set eth0 up
    udhcpc -i eth0 -b -q -t 10 -s /usr/share/udhcpc/default.script
fi

# Hora real por NTP: el reloj virtual arranca en una fecha fija y sin la hora
# correcta fallan los certificados TLS (docker pull).
ntpd -n -q -p pool.ntp.org >/dev/null 2>&1 && echo "rc: hora sincronizada: $(date)"
