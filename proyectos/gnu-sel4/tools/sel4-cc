#!/bin/sh
# sel4-cc: compilador de C para programas de GNU/seL4 (como musl-gcc).
#
# Compila contra musl portada y enlaza un ELF estático con base 0x10000000
# (la región de imagen de las ranuras, ver include/sel4posix/procmem.h),
# con el runtime que traduce las syscalls a IPC de seL4.
#
# Sirve para portar programas con su propio build:
#   ./configure --host=x86_64-linux-musl CC=/ruta/a/sysroot/bin/sel4-cc
SYSROOT=$(cd "$(dirname "$0")/.." && pwd)
CC="clang --target=x86_64-linux-musl"
FLAGS="-nostdinc -isystem $SYSROOT/include -fno-pic -fno-stack-protector"

link=1
for a in "$@"; do
    case "$a" in -c|-S|-E|-M|-MM) link=0 ;; esac
done

if [ "$link" = 1 ]; then
    exec $CC $FLAGS -static -nostdlib -fuse-ld=lld \
        -Wl,--image-base=0x10000000 -Wl,-z,max-page-size=4096 -L"$SYSROOT/lib" \
        "$SYSROOT/lib/crt0.o" "$@" "$SYSROOT/lib/libsel4posix.a" "$SYSROOT/lib/libc.a"
else
    exec $CC $FLAGS "$@"
fi
