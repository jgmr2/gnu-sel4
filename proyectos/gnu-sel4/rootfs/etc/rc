#!/bin/sh
# /etc/rc: lo ejecuta init al arrancar, antes de la shell de sesión.

# Red nativa: DHCP o dirección fija según /etc/red.conf
red aplicar

# Compartir este sistema de archivos con la VM Linux en /mnt/sel4 (como /mnt/c en WSL)
/sbin/9pd /mnt/sel4 </dev/null >/tmp/9pd.log 2>&1 &

# make test: si existe /etc/prueba, correr las pruebas automáticas (resultados en /dev/kmsg)
[ -f /etc/prueba ] && sh /etc/pruebas.sh
