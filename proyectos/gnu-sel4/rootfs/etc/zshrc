# /etc/zshrc: configuración de zsh para todos en GNU/seL4
fpath=(/usr/share/zsh/$ZSH_VERSION/functions $fpath)
autoload -Uz compinit colors
compinit -u
colors
bindkey -e                                   # atajos estilo emacs (Ctrl-A, Ctrl-E, Ctrl-R...)
HISTFILE=~/.zsh_history HISTSIZE=2000 SAVEHIST=2000
setopt HIST_IGNORE_DUPS SHARE_HISTORY AUTO_CD
zstyle ':completion:*' menu select
PROMPT='%F{green}%n@%m%f:%F{blue}%~%f%# '
alias ls='ls --color=auto' ll='ls -l --color=auto' la='ls -la --color=auto'
